
Процедура ОбновлениеСтатусовТоваров() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Ссылка КАК Товар,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	Справочник.Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
		|		ПО Товары.Ссылка = Остатки.Товар";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Элемент = Справочники.СтатусыТоваров.НайтиПоРеквизиту("Товар", Выборка.Товар);
		Если Элемент.Пустая() Тогда
			Объект = Справочники.СтатусыТоваров.СоздатьЭлемент();
			Объект.Товар = Выборка.Товар;
			Объект.Наименование = Строка(Выборка.Товар);
		Иначе
			Объект = Элемент.ПолучитьОбъект();
		КонецЕсли;

		Объект.Остаток = Выборка.Остаток;
		Объект.Статус = ?(Выборка.Остаток > 0, "В наличии", "Нет в наличии");
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Объект.Записать();

	КонецЦикла;
КонецПроцедуры
