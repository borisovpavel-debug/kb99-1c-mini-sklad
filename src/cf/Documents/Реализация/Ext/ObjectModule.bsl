#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	// Блокируем остатки, чтобы два документа не списали одну партию
	ЗаблокироватьОстатки();

	// Партии подбираем и проверяем ДО записи движений
	ТаблицаСписания = ПартииДляСписанияПоFIFO(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьДвиженияОстатков();
	ЗаполнитьДвиженияПартий(ТаблицаСписания);
	ЗаполнитьДвиженияОборотов(ТаблицаСписания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьОстатки()

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ПартииТоваров", ",") Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = Товары;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	КонецЦикла;
	Блокировка.Заблокировать();

КонецПроцедуры

// Возвращает таблицу «Товар, Партия, Количество, Стоимость»:
// что и из каких партий списать, от самой ранней партии к поздней.
// Если товара не хватает, выводит сообщение и ставит Отказ.
Функция ПартииДляСписанияПоFIFO(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.Количество КАК Количество
	|ПОМЕСТИТЬ ВТТоварыДокумента
	|ИЗ
	|	&ТоварыДокумента КАК ТоварыДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТоварыДокумента.Товар КАК Товар,
	|	СУММА(ВТТоварыДокумента.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТНужноСписать
	|ИЗ
	|	ВТТоварыДокумента КАК ВТТоварыДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТоварыДокумента.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНужноСписать.Товар КАК Товар,
	|	ВТНужноСписать.Количество КАК НужноСписать,
	|	Партии.Партия КАК Партия,
	|	ЕСТЬNULL(Партии.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(Партии.СтоимостьОстаток, 0) КАК СтоимостьОстаток
	|ИЗ
	|	ВТНужноСписать КАК ВТНужноСписать
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваров.Остатки(
	|				&Момент,
	|				Товар В
	|					(ВЫБРАТЬ
	|						Т.Товар
	|					ИЗ
	|						ВТНужноСписать КАК Т)) КАК Партии
	|		ПО ВТНужноСписать.Товар = Партии.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	Партии.Партия.МоментВремени";

	Запрос.УстановитьПараметр("ТоварыДокумента", Товары.Выгрузить(, "Товар, Количество"));
	// «Исключая» не учитывает старые движения этого же документа при перепроведении
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Исключая));

	ТаблицаСписания = Новый ТаблицаЗначений;
	ТаблицаСписания.Колонки.Добавить("Товар");
	ТаблицаСписания.Колонки.Добавить("Партия");
	ТаблицаСписания.Колонки.Добавить("Количество");
	ТаблицаСписания.Колонки.Добавить("Стоимость");

	ТекущийТовар = Неопределено;
	ОсталосьСписать = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.Товар <> ТекущийТовар Тогда
			ПроверитьНехватку(ТекущийТовар, ОсталосьСписать, Отказ);
			ТекущийТовар = Выборка.Товар;
			ОсталосьСписать = Выборка.НужноСписать;
		КонецЕсли;

		Если ОсталосьСписать = 0 Или Выборка.КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Списать = Мин(Выборка.КоличествоОстаток, ОсталосьСписать);

		СтрокаСписания = ТаблицаСписания.Добавить();
		СтрокаСписания.Товар = Выборка.Товар;
		СтрокаСписания.Партия = Выборка.Партия;
		СтрокаСписания.Количество = Списать;
		Если Списать = Выборка.КоличествоОстаток Тогда
			СтрокаСписания.Стоимость = Выборка.СтоимостьОстаток; // партия целиком, без копеек от округления
		Иначе
			СтрокаСписания.Стоимость = Окр(Выборка.СтоимостьОстаток / Выборка.КоличествоОстаток * Списать, 2);
		КонецЕсли;

		ОсталосьСписать = ОсталосьСписать - Списать;

	КонецЦикла;
	ПроверитьНехватку(ТекущийТовар, ОсталосьСписать, Отказ);

	Возврат ТаблицаСписания;

КонецФункции

Процедура ПроверитьНехватку(Товар, ОсталосьСписать, Отказ)

	Если Товар = Неопределено Или ОсталосьСписать <= 0 Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон("Не хватает товара %1: %2", Товар, ОсталосьСписать);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

Процедура ЗаполнитьДвиженияОстатков()

	Движения.ОстаткиТоваров.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Количество = СтрокаТоваров.Количество;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДвиженияПартий(ТаблицаСписания)

	Движения.ПартииТоваров.Записывать = Истина;
	Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
		Движение = Движения.ПартииТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаСписания.Товар;
		Движение.Партия = СтрокаСписания.Партия;
		Движение.Количество = СтрокаСписания.Количество;
		Движение.Стоимость = СтрокаСписания.Стоимость;
	КонецЦикла;

КонецПроцедуры

// Себестоимость строки = средняя стоимость списанных партий товара * количество строки
Процедура ЗаполнитьДвиженияОборотов(ТаблицаСписания)

	ИтогиПоТоварам = ТаблицаСписания.Скопировать();
	ИтогиПоТоварам.Свернуть("Товар", "Количество, Стоимость");

	Движения.ОборотыТоваров.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл

		Себестоимость = 0;
		ИтогТовара = ИтогиПоТоварам.Найти(СтрокаТоваров.Товар, "Товар");
		Если ИтогТовара <> Неопределено И ИтогТовара.Количество <> 0 Тогда
			Себестоимость = Окр(ИтогТовара.Стоимость / ИтогТовара.Количество * СтрокаТоваров.Количество, 2);
		КонецЕсли;

		Движение = Движения.ОборотыТоваров.Добавить();
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Контрагент = Контрагент;
		Движение.ВидОперации = Перечисления.ВидыОпераций.Реализация;
		Движение.Количество = СтрокаТоваров.Количество;
		Движение.Сумма = СтрокаТоваров.Сумма;
		Движение.Себестоимость = Себестоимость;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти