#Область ПрограммныйИнтерфейс

// Заполняет табличный документ печатной формой накладной.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - куда выводится печатная форма
//  СсылкиНаДокументы - ДокументСсылка.Реализация, Массив - что печатаем
Процедура Печать(ТабличныйДокумент, СсылкиНаДокументы) Экспорт

	Макет = Документы.Реализация.ПолучитьМакет("Печать");
	ВыборкаДокументов = ДанныеДляПечати(СсылкиНаДокументы).Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьТоварыШапка = Макет.ПолучитьОбласть("ТоварыШапка");
	ОбластьТовары = Макет.ПолучитьОбласть("Товары");

	ТабличныйДокумент.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока ВыборкаДокументов.Следующий() Цикл

		Если ВставлятьРазделительСтраниц Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабличныйДокумент.Вывести(ОбластьЗаголовок);

		ОбластьШапка.Параметры.Заполнить(ВыборкаДокументов);
		ТабличныйДокумент.Вывести(ОбластьШапка, ВыборкаДокументов.Уровень());

		ТабличныйДокумент.Вывести(ОбластьТоварыШапка);
		ВыборкаТоваров = ВыборкаДокументов.Товары.Выбрать();
		Пока ВыборкаТоваров.Следующий() Цикл
			ОбластьТовары.Параметры.Заполнить(ВыборкаТоваров);
			ТабличныйДокумент.Вывести(ОбластьТовары, ВыборкаТоваров.Уровень());
		КонецЦикла;

		ВставлятьРазделительСтраниц = Истина;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПечати(СсылкиНаДокументы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реализация.Дата КАК Дата,
	|	Реализация.Контрагент КАК Контрагент,
	|	Реализация.Номер КАК Номер,
	|	Реализация.Товары.(
	|		Товар КАК Товар,
	|		Количество КАК Количество,
	|		Цена КАК Цена,
	|		Сумма КАК Сумма
	|	) КАК Товары
	|ИЗ
	|	Документ.Реализация КАК Реализация
	|ГДЕ
	|	Реализация.Ссылка В (&СсылкиНаДокументы)";
	Запрос.УстановитьПараметр("СсылкиНаДокументы", СсылкиНаДокументы);

	Возврат Запрос.Выполнить();

КонецФункции

#КонецОбласти