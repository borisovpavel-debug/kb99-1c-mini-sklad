#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(ИНН) И Не ИННКорректен(ИНН) Тогда
		СообщитьОбОшибке("ИНН должен состоять из 10 или 12 цифр", "ИНН", Отказ);
	КонецЕсли;

	Если ЗначениеЗаполнено(КПП) И Не КППКорректен(КПП) Тогда
		СообщитьОбОшибке("КПП должен состоять из 9 цифр", "КПП", Отказ);
	КонецЕсли;

	Для Каждого СтрокаКонтакта Из КонтактнаяИнформация Цикл

		ЗначениеКонтакта = СтрокаКонтакта.ЗначениеКонтактнойИнформации;

		Если СтрокаКонтакта.Вид = "Телефон" И Не ЭтоТелефон(ЗначениеКонтакта) Тогда
			СообщитьОбОшибке(СтрШаблон("Строка %1: телефон должен содержать 11 цифр и начинаться с 89 или 79",
				СтрокаКонтакта.НомерСтроки), "КонтактнаяИнформация", Отказ);
		ИначеЕсли СтрокаКонтакта.Вид = "Почта" И Не ЭтоПочта(ЗначениеКонтакта) Тогда
			СообщитьОбОшибке(СтрШаблон("Строка %1: неверный адрес почты",
				СтрокаКонтакта.НомерСтроки), "КонтактнаяИнформация", Отказ);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Проверки

// Возвращаемое значение:
//  Булево - Истина, если ИНН из 10 или 12 цифр
Функция ИННКорректен(ЗначениеИНН)

	ДлинаИНН = СтрДлина(ЗначениеИНН);
	Возврат ТолькоЦифры(ЗначениеИНН) И (ДлинаИНН = 10 Или ДлинаИНН = 12);

КонецФункции

// Возвращаемое значение:
//  Булево - Истина, если КПП из 9 цифр
Функция КППКорректен(ЗначениеКПП)

	Возврат ТолькоЦифры(ЗначениеКПП) И СтрДлина(ЗначениеКПП) = 9;

КонецФункции

// Возвращаемое значение:
//  Булево - Истина, если номер из 11 цифр и начинается с 79 или 89.
//  Пробелы, скобки, дефисы и плюс не учитываются
Функция ЭтоТелефон(Знач НомерТелефона)

	Для Каждого ЛишнийСимвол Из СтрРазделить("+, ,-,(,)", ",") Цикл
		НомерТелефона = СтрЗаменить(НомерТелефона, ЛишнийСимвол, "");
	КонецЦикла;

	ПервыеДвеЦифры = Лев(НомерТелефона, 2);

	Возврат СтрДлина(НомерТелефона) = 11
		И ТолькоЦифры(НомерТелефона)
		И (ПервыеДвеЦифры = "79" Или ПервыеДвеЦифры = "89");

КонецФункции

// Возвращаемое значение:
//  Булево - Истина, если перед @ есть символы, а после @ есть точка
Функция ЭтоПочта(АдресПочты)

	ПозицияСобаки = СтрНайти(АдресПочты, "@");
	Возврат ПозицияСобаки > 1 И СтрНайти(Сред(АдресПочты, ПозицияСобаки), ".") > 0;

КонецФункции

#КонецОбласти

#Область Служебные

// Возвращаемое значение:
//  Булево - Истина, если строка состоит только из цифр
Функция ТолькоЦифры(Значение)

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура СообщитьОбОшибке(ТекстОшибки, ИмяПоля, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти